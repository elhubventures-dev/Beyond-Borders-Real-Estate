# Public site URL used in emails and canonical links
NEXT_PUBLIC_SITE_URL=https://www.beyondborders.ng

# Resend — https://resend.com/api-keys
# 1. Create an API key and paste it below.
# 2. In Resend, add the domain beyondborders.ng and publish the DNS records it shows.
#    Mail from info@beyondborders.ng is rejected until that domain is verified.
RESEND_API_KEY=
# Inbox that receives consultation, inspection, and document-request notifications
CONTACT_TO_EMAIL=info@beyondborders.ng
# Verified sender. Must be an address on the domain added in Resend.
EMAIL_FROM=Beyond Borders <info@beyondborders.ng>

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
